Algoritmo Ejercicio
	//Pedir un número e indicar si es positivo o negativo.
	
	//Definicion de variables
	Definir Num como real;
	
	//Entrada
	Escribir "Digite un número";
	Leer Num;
	//Proceso 
	Si num <0 Entonces
		Escribir "Su número es negativo";
	Sino
		Escribir " Su número es positivo";
	FinSi
FinAlgoritmo
