Algoritmo Ejercicio8
	//STIVEN GONZALEZ
	//Hacer un algoritmo que lea el nombre de una persona y número de horas que estudia
	//a la semana
	
	//Definicion de variables
	Definir Nombre como cadena;
	Definir Horas Como Real;
	
	//entrada
	Escribir "Digite el nombre de la persona y el número de horas que estudia a la semana";
	Leer Nombre;
	Leer Horas;
	
	//salida
	Escribir "El nombre es ",Nombre, " y las horas que trabaja a la semana son: ",Horas;
FinAlgoritmo
