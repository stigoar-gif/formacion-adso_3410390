Algoritmo EJERCICIO27
	//STIVEN GONZALEZ 
	//Pedir un numero y decir si es par o impar.
	
	//DEFINICION DE VARIABLES
	Definir numero Como Entero;
	
	//ENTRADA
	Escribir "Ingrese el numero";
	Leer numero;
	
	//PROCESO
	si numero MOD 2 = 0 Entonces
		Escribir "Su numero ingresado es un numero PAR";
	SiNo
		Escribir "El numero ingresado es un numero IMPAR";
	FinSi
FinAlgoritmo
	

