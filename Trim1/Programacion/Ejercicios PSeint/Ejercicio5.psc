Algoritmo Ejercicio5
	//STIVEN GONZALEZ
	//Hacer un algoritmo que lea dos números enteros y muestre el resultado de
	//realizar (A+B)*2+10
	
	//Definir variables
	Definir Num1 como entero;
	Definir Num2 como entero;
	Definir Resultado como entero;
	
	//Entrada
	Escribir " Escriba su Número 1 y su número 2 ";
	Leer Num1, Num2;
	
	//Proceso 
	Resultado<- (Num1+Num2)*2+10;
	
	//Salida
	Escribir " El resultado de su operación es ", Resultado;
	
FinAlgoritmo
