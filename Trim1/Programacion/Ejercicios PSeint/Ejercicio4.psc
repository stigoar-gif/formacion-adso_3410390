Algoritmo Ejercicio4
	//STIVEN GONZALEZ
	//Hacer un algoritmo que declare una variable para guardar
	//el promedio del semestre, otra para guardar el nombre
	// de un estudiante y otro para guardar el numero de notas perdidas
	
	//Definicion de variables
	Definir NombEstudiante como cadena;
	Definir PromedioSem Como Real;
	Definir NotasPerdidas como real;
	
	//Asignación de variables
	NombEstudiante<- "Stiven";
	PromedioSem<- 4.2;
	NotasPerdidas<- 3;
	
	Escribir " El nombre del estudiante es ", NombEstudiante,", su promedio del semestre es de ", PromedioSem, " y sus notas perdidas fueron ", NotasPerdidas,".";
	
FinAlgoritmo
