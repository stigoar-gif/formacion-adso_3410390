Algoritmo Ejercicio1
	//STIVEN GONZALEZ
	// Hacer un algoritmo que declare una variable para guardar el número de horas de estudio
	// y otra para guardar el nombre. Escribir ambos datos
	
	//Definicion de variables
	Definir HorasEstudio Como Real;
	Definir Nombre como cadena;
	
	//entrada
	HorasEstudio<- 12;
	Nombre<- " Stiven ";
	
	//salida
	Escribir " Su nombre es", Nombre,"y sus horas de estudio son: ", HorasEstudio;
FinAlgoritmo
