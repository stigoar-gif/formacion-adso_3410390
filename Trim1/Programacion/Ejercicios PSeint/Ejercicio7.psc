Algoritmo Ejercicio7
	//STIVEN GONZALEZ
	//Hacer un algoritmo para sumar dos números, los cuales serán tecleados por el usuario
	//Mostrar el resultado
	
	//Definicion de variables
	Definir Num1 Como Real;
	Definir Num2 Como Real;
	Definir Resultado como real;
	
	//Entrada
	Escribir "Digite su numero uno y su número dos para realizar su operación";
	Leer Num1,Num2;
	
	//Proceso 
	Resultado<-Num1+Num2;
	
	//Salida
	Escribir " El resultado de su operación es: ",Resultado;
	
FinAlgoritmo
